{
  "selectdo": {
    "prefix": ["select", "sel", "selectdo"],
    "description": "Embedded SQL selectdo block (select / from / selectdo / endselect)",
    "body": [
      "select ${1:table}.*",
      "from $1",
      "where $1.${2:field} = :${3:value}",
      "selectdo",
      "\t$0",
      "selectempty",
      "\t",
      "endselect"
    ]
  },
  "select for update": {
    "prefix": ["selfor", "selectfor"],
    "description": "select … for update with selectdo / selectempty",
    "body": [
      "select ${1:table}.*",
      "from $1 for update",
      "where $1.${2:field} = :${3:value}",
      "selectdo",
      "\t$0",
      "selectempty",
      "\t",
      "endselect"
    ]
  },
  "sql update": {
    "prefix": "sqlupd",
    "description": "Embedded SQL update block",
    "body": [
      "update ${1:table}",
      "set ${2:field} = ${3:value}",
      "where ${4:condition}",
      "endupdate",
      "$0"
    ]
  },
  "sql delete": {
    "prefix": "sqldel",
    "description": "Embedded SQL delete block",
    "body": [
      "delete ${1:table}.*",
      "from $1",
      "where ${2:condition}",
      "enddelete",
      "$0"
    ]
  },
  "field section": {
    "prefix": "fld",
    "description": "4GL field section",
    "body": [
      "field.${1:table}.${2:field}:",
      "before.input:",
      "\t$0",
      "after.field:",
      "\t"
    ]
  },
  "choice section": {
    "prefix": "chc",
    "description": "4GL choice section",
    "body": [
      "choice.${1:print.data}:",
      "on.choice:",
      "\t$0"
    ]
  },
  "report header layout": {
    "prefix": "header",
    "description": "Report header.N with before.layout",
    "body": [
      "header.${1:1}:",
      "before.layout:",
      "\t$0"
    ]
  },
  "report detail layout": {
    "prefix": "detail",
    "description": "Report detail.N with before.layout",
    "body": [
      "detail.${1:1}:",
      "before.layout:",
      "\t$0"
    ]
  },
  "function": {
    "prefix": "fun",
    "description": "3GL extern function",
    "body": [
      "function extern ${1:long} ${2:name}()",
      "{",
      "\t$0",
      "}"
    ]
  },
  "function main": {
    "prefix": "main",
    "description": "3GL program entry",
    "body": [
      "function main()",
      "{",
      "\t$0",
      "}"
    ]
  },
  "while endwhile": {
    "prefix": "wh",
    "description": "while / endwhile (prefix wh — avoids clashing with keyword while)",
    "body": [
      "while ${1:condition}",
      "\t$0",
      "endwhile"
    ]
  },
  "case endcase": {
    "prefix": "onc",
    "description": "on case / case / endcase (prefix onc — avoids clashing with keyword case)",
    "body": [
      "on case ${1:expression}",
      "case ${2:value}:",
      "\t$0",
      "default:",
      "\t",
      "endcase"
    ]
  },
  "for endfor": {
    "prefix": "forn",
    "description": "for / endfor (prefix forn — avoids clashing with keyword for)",
    "body": [
      "for ${1:i} = ${2:1} to ${3:n}",
      "\t$0",
      "endfor"
    ]
  },
  "DAL before.save.object": {
    "prefix": "dalsave",
    "description": "DAL2 before.save.object hook (long mode)",
    "body": [
      "function extern long before.save.object(long mode)",
      "{",
      "\ton case mode",
      "\tcase DAL_NEW:",
      "\t\tif ${1:table}.${2:field} = \"\" then",
      "\t\t\treturn(DALHOOKERROR)",
      "\t\tendif",
      "\t\tbreak",
      "\tcase DAL_UPDATE:",
      "\t\tbreak",
      "\tendcase",
      "\treturn(0)",
      "}"
    ]
  },
  "dalnew": {
    "prefix": "dalnew",
    "description": "DAL1 new object + set.field + save with commit/abort",
    "body": [
      "ret = dal.new.object(\"${1:table}\")",
      "dal.set.field(\"$1.${2:field}\", ${3:value})",
      "ret = dal.save.object(\"$1\")",
      "if ret <> 0 then",
      "\tret = dal.get.error.message(err.msg)",
      "\tabort.transaction()",
      "else",
      "\tcommit.transaction()",
      "endif",
      "$0"
    ]
  },
  "dalup": {
    "prefix": "dalup",
    "description": "DAL1 change object + set.field + save with commit/abort",
    "body": [
      "ret = dal.change.object(\"${1:table}\")",
      "dal.set.field(\"$1.${2:field}\", ${3:value})",
      "ret = dal.save.object(\"$1\")",
      "if ret <> 0 then",
      "\tret = dal.get.error.message(err.msg)",
      "\tabort.transaction()",
      "else",
      "\tcommit.transaction()",
      "endif",
      "$0"
    ]
  },
  "daldel": {
    "prefix": "daldel",
    "description": "DAL1 destroy object with commit/abort",
    "body": [
      "ret = dal.destroy.object(\"${1:table}\")",
      "if ret <> 0 then",
      "\tret = dal.get.error.message(err.msg)",
      "\tabort.transaction()",
      "else",
      "\tcommit.transaction()",
      "endif",
      "$0"
    ]
  },
  "DAL field.is.valid": {
    "prefix": "dalvalid",
    "description": "DAL2 field.is.valid hook (table.field suffix)",
    "body": [
      "function extern boolean ${1:table}.${2:field}.is.valid(long mode)",
      "{",
      "\t$0",
      "\treturn(true)",
      "}"
    ]
  },
  "DAL field.is.mandatory": {
    "prefix": "dalmand",
    "description": "DAL2 field.is.mandatory hook",
    "body": [
      "function extern boolean ${1:table}.${2:field}.is.mandatory()",
      "{",
      "\t$0",
      "\treturn(true)",
      "}"
    ]
  },
  "DAL field.update": {
    "prefix": "dalupd",
    "description": "DAL2 field.update hook",
    "body": [
      "function extern void ${1:table}.${2:field}.update()",
      "{",
      "\t$0",
      "}"
    ]
  },
  "upd": {
    "prefix": "upd",
    "description": "db.retry.point + select for update + db.update / db.insert",
    "body": [
      "db.retry.point()",
      "",
      "select ${1:table}.*",
      "from $1 for update",
      "where $1.${2:field} = :${3:value}",
      "selectdo",
      "\t$1.${4:field} = ${5:value}",
      "\tdb.update(t$1, db.retry)",
      "selectempty",
      "\t$1.$4 = $5",
      "\tdb.insert(t$1, db.retry)",
      "endselect",
      "",
      "commit.transaction()",
      "$0"
    ]
  },
  "declaration": {
    "prefix": "decl",
    "description": "4GL declaration section",
    "body": [
      "declaration:",
      "\ttable   t${1:tdsls401}",
      "\textern  domain ${2:tcmcs.str30}  ${3:orno}",
      "",
      "$0"
    ]
  },
  "dllusage": {
    "prefix": ["dllu", "DllUsage", "dllusage"],
    "description": "DLL object description (bic_info6.2 -u)",
    "body": [
      "DllUsage",
      "${1:Object description}",
      "EndDllUsage",
      "",
      "$0"
    ]
  },
  "functionusage": {
    "prefix": ["fu", "FunctionUsage", "functionusage"],
    "description": "Function documentation (bic_info6.2 -eu): description + Input/Output/Return",
    "body": [
      "FunctionUsage",
      "${1:description}",
      "Input:\t${2:-}",
      "Output:\t${3:-}",
      "Return:\t${4:description}",
      "EndFunctionUsage",
      "$0"
    ]
  },
  "dll skeleton": {
    "prefix": "dll",
    "description": "dllusage + function extern skeleton",
    "body": [
      "dllusage",
      "\t${1:Library description}",
      "enddllusage",
      "",
      "function extern ${2:long} ${3:name}()",
      "{",
      "\t$0",
      "\treturn(0)",
      "}"
    ]
  },
  "report skeleton": {
    "prefix": "rep",
    "description": "Print session / report skeleton",
    "body": [
      "declaration:",
      "\ttable   t${1:table}",
      "",
      "choice.print.data:",
      "on.choice:",
      "\tif rprt_open() then",
      "\t\t${2:read.main.table}()",
      "\t\trprt_close()",
      "\telse",
      "\t\tchoice.again()",
      "\tendif",
      "",
      "functions:",
      "function $2()",
      "{",
      "\t$0",
      "}"
    ]
  },
  "include": {
    "prefix": "inc",
    "description": "Preprocessor #include",
    "body": [
      "#include \"${1:file}\"",
      "$0"
    ]
  },
  "ifdef": {
    "prefix": "ppif",
    "description": "Preprocessor #ifdef / #endif",
    "body": [
      "#ifdef ${1:SYMBOL}",
      "$0",
      "#endif"
    ]
  },
  "ifndef guard": {
    "prefix": "ppifndef",
    "description": "Preprocessor include guard (#ifndef / #define / #endif)",
    "body": [
      "#ifndef ${1:GUARD}",
      "#define $1",
      "$0",
      "#endif"
    ]
  },
  "form section": {
    "prefix": "form",
    "description": "4GL form section",
    "body": [
      "form.${1:1}:",
      "init.form:",
      "\t$0",
      "before.form:",
      "\t",
      "after.form:",
      "\t"
    ]
  },
  "group section": {
    "prefix": "group",
    "description": "4GL group section",
    "body": [
      "group.${1:1}:",
      "init.group:",
      "\t$0",
      "before.group:",
      "\t",
      "after.group:",
      "\t"
    ]
  },
  "main table io": {
    "prefix": "maintable",
    "description": "4GL main.table.io section",
    "body": [
      "main.table.io:",
      "before.read:",
      "\t$0",
      "after.read:",
      "\t",
      "before.write:",
      "\t",
      "after.write:",
      "\t"
    ]
  },
  "zoom from section": {
    "prefix": "zoom",
    "description": "4GL zoom.from section",
    "body": [
      "zoom.from.${1:field}:",
      "on.entry:",
      "\t$0",
      "on.exit:",
      "\t"
    ]
  }
}
